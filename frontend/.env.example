# Copy to frontend/.env.local. Per-screen display defaults; each screen can still change them in the app.
# LLM, news and cache settings are on the server: see backend/.env.example.
VITE_AUTO_TOUR=false
VITE_IDLE_TOUR_SECONDS=90
VITE_TOUR_DWELL_SECONDS=25
VITE_HEATMAP=true
# Root text scale (1 = 16px base). 1.2–1.5 suits large wall displays.
VITE_UI_SCALE=1
