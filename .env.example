# Copy to .env.local and adjust. Values here override the built-in defaults;
# the in-app admin drawer (long-press the title for 2s) overrides these at runtime.

# OpenAI-compatible endpoint (base URL up to /v1)
VITE_LLM_BASE_URL=http://172.27.50.106:11434/v1
VITE_LLM_MODEL=granite4.2:8b
VITE_LLM_API_KEY=
# Sent as `reasoning_effort`. Leave empty to omit the parameter (needed for non-reasoning endpoints that reject it).
VITE_LLM_REASONING_EFFORT=none
VITE_LLM_TEMPERATURE=0.25
# Context window of the model server. Ollama defaults to 4096 and rejects longer requests;
# raise OLLAMA_CONTEXT_LENGTH on the server (e.g. 16384) and set the same value here for richer reports.
VITE_LLM_CONTEXT_TOKENS=4096

# Naver Search API (https://developers.naver.com). Without keys only Google News RSS is used.
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=
# Comma-separated, in priority order: naver, google
VITE_NEWS_PROVIDERS=naver,google
VITE_NEWS_MAX=30
VITE_NEWS_DAYS=14

# Idle auto-tour
VITE_AUTO_TOUR=false
VITE_IDLE_TOUR_SECONDS=90
VITE_TOUR_DWELL_SECONDS=25
VITE_HEATMAP=true
# Root text scale for the display (1 = 16px base)
VITE_UI_SCALE=1
