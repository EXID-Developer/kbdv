# Copy to backend/.env and adjust. Values here override the built-in defaults;
# the admin settings in the app (⚙ or Ctrl/⌘ + ,) override these at runtime and are shared by every screen.

# Server
PORT=8787
HOST=0.0.0.0
# Protects admin actions (settings, cache, pre-generation). Strongly recommended when other computers connect.
ADMIN_TOKEN=
# Where reports and saved settings are stored (relative to backend/)
DATA_DIR=data

# OpenAI-compatible endpoint (base URL up to /v1). Called by the server, so browsers need no CORS setup.
LLM_BASE_URL=http://172.27.50.106:11434/v1
LLM_MODEL=granite4.2:8b
LLM_API_KEY=
# Sent as `reasoning_effort`. Leave empty to omit the parameter (needed for non-reasoning endpoints that reject it).
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.25
# Context window of the model server. Ollama defaults to 4096 and rejects longer requests;
# raise OLLAMA_CONTEXT_LENGTH on the server (e.g. 16384) and set the same value here for richer reports.
LLM_CONTEXT_TOKENS=4096

# Naver Search API (https://developers.naver.com). Without keys only Google News RSS is used.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Comma-separated, in priority order: naver, google
NEWS_PROVIDERS=naver,google
NEWS_MAX=30
NEWS_DAYS=14
# Reports older than this are regenerated when opened, so issue filters stay current. 0 = keep forever.
REPORT_TTL_MINUTES=60
